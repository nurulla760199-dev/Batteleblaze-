            <button class="close-btn" onclick="closeModal()">Samajh Gaya (Close)</button>
        </div>
    </div>

    <script>
        function openModal() {
            document.getElementById('policyModal').style.display = 'flex';
        }
        function closeModal() {
            document.getElementById('policyModal').style.display = 'none';
        }
    </script>

</body>
</html>
